# Variable names only. Real values live in .env.local and in the Vercel project settings.
# Never commit values, and never put a personal email address in any of these.

# Clerk production instance, used everywhere. pk_live_ and sk_live_ keys work only on the production
# domain: Clerk refuses them on localhost, so sign-in is tried on the deployed site
# (https://noren.yooi.me; see specs/001-noren-mvp/quickstart.md).
CLERK_SECRET_KEY=
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=

# Convex (written by `npx convex dev`)
NEXT_PUBLIC_CONVEX_URL=
NEXT_PUBLIC_CONVEX_SITE_URL=
CONVEX_DEPLOYMENT=
# Clerk Frontend API URL (production: https://clerk.noren.yooi.me). Also set it on the matching
# Convex deployment, where convex/auth.config.ts reads it.
CLERK_JWT_ISSUER_DOMAIN=

# AI runs in Convex actions, so set these on the Convex deployment (`npx convex env set`), not only here.
# Without them the app offers the typed-transcript fallback (src/lib/ai/config.ts).
# Language models: one model id per step. A "vendor/model" id goes through AI Gateway (AI_GATEWAY_API_KEY);
# a slashless id is an Anthropic model called directly (ANTHROPIC_API_KEY).
AI_GATEWAY_API_KEY=
ANTHROPIC_API_KEY=
AI_MODEL_EXTRACT=
AI_MODEL_TRANSLATE=
AI_MODEL_COMPOSE=
AI_MODEL_ENTAIL=

# Transcription: TRANSCRIBE_PROVIDER is "gateway" (uses AI_GATEWAY_API_KEY and a vendor/model id) or
# "openai-compatible" (any OpenAI-style /audio/transcriptions endpoint; production uses whisper-1).
TRANSCRIBE_PROVIDER=
TRANSCRIBE_MODEL=
TRANSCRIBE_BASE_URL=
TRANSCRIBE_API_KEY=
# Optional upload limit in bytes
TRANSCRIBE_MAX_BYTES=

# Optional: which regions/<id>.json to serve when there is more than one (default: the only region)
REGION_ID=

# User-Agent for geocoding requests: the project name and repository address only,
# for example "Noren/0.1 (+<repository address>)". No personal email address.
GEO_USER_AGENT=
