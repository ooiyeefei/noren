# Variable names only. Real values live in .env.local and in the Vercel project settings.
# Never commit values, and never put a personal email address in any of these.

# Clerk production instance, used everywhere. pk_live_ and sk_live_ keys work only on the production
# domain: Clerk refuses them on localhost, so sign-in is tried on the deployed site
# (https://noren.yooi.me; see specs/001-noren-mvp/quickstart.md).
CLERK_SECRET_KEY=
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=

# Convex (written by `npx convex dev`)
NEXT_PUBLIC_CONVEX_URL=
NEXT_PUBLIC_CONVEX_SITE_URL=
CONVEX_DEPLOYMENT=
# Clerk Frontend API URL (production: https://clerk.noren.yooi.me). Also set it on the matching
# Convex deployment, where convex/auth.config.ts reads it.
CLERK_JWT_ISSUER_DOMAIN=

# AI runs in Convex actions, so set these on the Convex deployment (`npx convex env set`), not only here.
# Without them the app offers the typed-transcript fallback (src/lib/ai/config.ts).
# Language models: one model id per step, so switching provider is a settings change. A "vendor/model"
# id goes through AI Gateway (AI_GATEWAY_API_KEY); "meta:muse-spark-1.3" calls the Meta Model API
# (META_API_KEY); a slashless id is an Anthropic model called directly (ANTHROPIC_API_KEY).
# Meta's "-contributor" models are refused: Meta trains on what they receive.
AI_GATEWAY_API_KEY=
ANTHROPIC_API_KEY=
META_API_KEY=
AI_MODEL_EXTRACT=
AI_MODEL_TRANSLATE=
# Reserved, not read by any step yet: the page composer is deterministic and entailment is
# verbatim-only (task T072), so setting these changes nothing.
AI_MODEL_COMPOSE=
AI_MODEL_ENTAIL=
# The follow-up agent suggests what the interviewer could ask next; it needs tool calling.
AI_MODEL_FOLLOWUP=
# The translation check compares each machine translation with the person's words, or with a
# found post's quote. Unset, it is off. "modal:noren-glimmer" calls our OpenAI-compatible Modal endpoint at MODAL_BASE_URL (its
# root URL, without /v1) with MODAL_PROXY_TOKEN; any other model id above works too.
AI_MODEL_CHECK_TRANSLATION=
MODAL_BASE_URL=
MODAL_PROXY_TOKEN=
# The story finder's check of each found public post (one tool call per post), for example
# meta:muse-spark-1.3. Quotes of found posts are translated with AI_MODEL_TRANSLATE.
AI_MODEL_CHECK_MENTION=
# The story agent. Writes a place's story from its checked posts, such as meta:muse-spark-1.3.
# The same model drafts a member's line from a post they tick as their own.
AI_MODEL_WRITE_STORY=
# A second model reads each sentence against the words it cites, such as modal:noren-glimmer.
AI_MODEL_CHECK_STORY=

# Transcription: TRANSCRIBE_PROVIDER is "gateway" (uses AI_GATEWAY_API_KEY and a vendor/model id),
# "openai-compatible" (any OpenAI-style /audio/transcriptions endpoint; whisper-1 before Meta) or
# "meta" (META_API_KEY with TRANSCRIBE_MODEL=muse-voice-transcribe-1.0; the recorder then uploads
# 16 kHz mono WAV, about 1.9 MB a minute, which the server sends in parts of 9 minutes).
TRANSCRIBE_PROVIDER=
TRANSCRIBE_MODEL=
TRANSCRIBE_BASE_URL=
TRANSCRIBE_API_KEY=
# Optional upload limit in bytes (openai-compatible only)
TRANSCRIBE_MAX_BYTES=

# Story finder collection (scripts/story-finder.ts) runs on your machine, not on Convex: the Apify
# API token it uses to search public posts. Keep it in .env.local only.
APIFY_TOKEN=

# Optional: which regions/<id>.json to serve when there is more than one (default: the only region)
REGION_ID=

# User-Agent for geocoding requests: the project name and repository address only,
# for example "Noren/0.1 (+<repository address>)". No personal email address.
GEO_USER_AGENT=
